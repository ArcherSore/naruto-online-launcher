# Dependencies
node_modules/

# Build output
dist/
out/

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Electron
*.asar

# Flash PPAPI binaries — downloaded on-demand by FlashUpdater (Decisão A / Fase 2)
# Never version-control the 32MB binaries; cache lives in userData/flash-cache/.
flash/*.so
flash/*.dll
flash/flash-cache/
# manifest.json stays versioned (small, used as version fallback).

# Other package managers (npm only)
bun.lock
bun.lockb
yarn.lock
pnpm-lock.yaml

# Test coverage
coverage/

# Backup files
*.bak
*.tmp
